FIREBASE_API_KEY=YOUR_FIREBASE_WEB_KEY_FROM_AORTEM_SAMPLE_APPS
OAUTH2_CLIENT_ID=client_...
OAUTH2_CLIENT_SECRET=secret_...
# Optional: override the billing host used to mint the OAuth2 token.
API_BILLING=https://apibilling.dartstream.io
# Optional: limit the scopes requested from the client credentials grant.
# OAUTH2_SCOPE=platform:read flags:read projects:read
