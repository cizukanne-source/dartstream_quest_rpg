FIREBASE_API_KEY=YOUR_FIREBASE_WEB_KEY_FROM_AORTEM_SAMPLE_APPS
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
OAUTH2_CLIENT_ID=client_...
OAUTH2_CLIENT_SECRET=secret_...
# Optional: override the billing host used to mint the OAuth2 token.
API_BILLING=https://dev-apibilling.dartstream.io
# Optional: limit the scopes requested from the client credentials grant.
# OAUTH2_SCOPE=platform:read flags:read projects:read

# IntelliToggle build defines for the Flutter app
# Use https://dev-api.intellitoggle.com if the OAuth client was created on the
# IntelliToggle dev dashboard; otherwise the code defaults to production.
INTELLITOGGLE_API_URL=https://dev-api.intellitoggle.com
INTELLITOGGLE_CLIENT_ID=client_...
INTELLITOGGLE_CLIENT_SECRET=secret_...
INTELLITOGGLE_TENANT_ID=tenant_...

# Optional IntelliToggle deep-dive overrides
# INTELLITOGGLE_BOOL_FLAG=new-dashboard
# INTELLITOGGLE_STRING_FLAG=hero-variant
# INTELLITOGGLE_INT_FLAG=max-items
# INTELLITOGGLE_OBJECT_FLAG=theme-config
# INTELLITOGGLE_TARGET_USER=deepdive-cli
